#!/usr/bin/env bash
# Run as root on the production host. It reads a password from the terminal,
# writes only a scrypt hash, and leaves no plaintext password in shell history.
set -euo pipefail

if [ "${EUID}" -ne 0 ]; then
  echo "Run this with sudo." >&2
  exit 1
fi

read -r -s -p "Private-beta password: " password
echo
read -r -s -p "Repeat private-beta password: " confirmation
echo

if [ "$password" != "$confirmation" ]; then
  echo "Passwords did not match; nothing was changed." >&2
  exit 1
fi

hash=$(printf '%s' "$password" | /opt/node/bin/node -e '
  const crypto = require("node:crypto");
  const fs = require("node:fs");
  const password = fs.readFileSync(0, "utf8");
  const salt = crypto.randomBytes(16);
  const derived = crypto.scryptSync(password, salt, 64, {
    N: 16384, r: 8, p: 1, maxmem: 64 * 1024 * 1024,
  });
  console.log(`scrypt$16384$8$1$${salt.toString("base64")}$${derived.toString("base64")}`);
')
unset password confirmation

env_file=/etc/wordrush/rush.env
temporary=$(mktemp)
trap 'rm -f "$temporary"' EXIT
grep -v '^WORDRUSH_BETA_PASSWORD_HASH=' "$env_file" >"$temporary" || true
printf 'WORDRUSH_BETA_PASSWORD_HASH=%s\n' "$hash" >>"$temporary"
install -o root -g wordrush -m 0640 "$temporary" "$env_file"

echo "Private-beta password hash saved. The Wordrush service is still disabled."
