# Copy this file outside the repository (for example /etc/wordrush/wordrush.env)
# and fill in the values. Never commit the real file.
NODE_ENV=production
HOST=127.0.0.1
PORT=8013
WORDRUSH_PUBLIC_ORIGIN=https://rush.nrdgrrrl.com

# Generate with the command in SECURITY.md. Do not use a plaintext password.
WORDRUSH_BETA_PASSWORD_HASH=
WORDRUSH_ALLOWED_ORIGINS=https://rush.nrdgrrrl.com
WORDRUSH_ALLOWED_HOSTS=rush.nrdgrrrl.com
WORDRUSH_SESSION_COOKIE_SECURE=1
WORDRUSH_SESSION_FILE=/var/lib/wordrush/sessions.json

# Set once the Custom Receiver entry has been created in the Cast console.
WORDRUSH_CAST_APPLICATION_ID=
