# Copy this file outside the repository (for example /etc/wordrush/wordrush.env)
# and fill in the values. Never commit the real file.
NODE_ENV=production
HOST=127.0.0.1
PORT=8013
WORDRUSH_PUBLIC_ORIGIN=https://wordrush.party

WORDRUSH_ALLOWED_ORIGINS=https://wordrush.party
WORDRUSH_ALLOWED_HOSTS=wordrush.party

# Set once the Custom Receiver entry has been created in the Cast console.
WORDRUSH_CAST_APPLICATION_ID=
